# Copia este archivo como .env y llena los valores. Nunca subas el .env.
PORT=3000

# Cadena de conexión de MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/pasele

# Firma de los JWT. Usa una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=8h

# Orígenes del frontend permitidos por CORS, separados por comas
CLIENT_ORIGINS=http://localhost:5173

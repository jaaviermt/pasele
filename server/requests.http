# Peticiones de prueba (extensión REST Client de VS Code).
# Ejecuta primero "Login correcto": las demás toman el token de esa respuesta.
@baseUrl = http://localhost:3000/api
@token = {{login.response.body.data.token}}

### Salud del servidor -> 200
GET {{baseUrl}}/health

### ---------- REGISTRO ----------

### Registro correcto -> 201
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Ana López",
  "email": "ana@correo.com",
  "password": "12345678"
}

### Correo duplicado (aunque cambien mayúsculas) -> 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "Otra Ana",
  "email": "ANA@correo.com",
  "password": "12345678"
}

### Campos inválidos y campo no permitido -> 400 con details
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "nombre": "",
  "email": "no-es-correo",
  "password": "123",
  "rol": "admin"
}

### JSON mal escrito -> 400
POST {{baseUrl}}/auth/register
Content-Type: application/json

{ "nombre":

### ---------- LOGIN ----------

### Login correcto -> 200 (guarda el token)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ana@correo.com",
  "password": "12345678"
}

### Contraseña incorrecta -> 401
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "ana@correo.com",
  "password": "otraclave"
}

### Correo que no existe -> 401 (mismo mensaje)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "nadie@correo.com",
  "password": "12345678"
}

### Campos vacíos -> 400
POST {{baseUrl}}/auth/login
Content-Type: application/json

{}

### ---------- RUTA PROTEGIDA ----------

### Con token -> 200
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Sin token -> 401
GET {{baseUrl}}/auth/me

### Token inválido -> 401
GET {{baseUrl}}/auth/me
Authorization: Bearer token.falso.123

### ---------- 404 ----------

### Ruta inexistente -> 404
GET {{baseUrl}}/no-existe

# =====================================================================
# FASE 2: CATÁLOGOS (todas requieren token: ejecuta antes "Login correcto")
# =====================================================================
@categoryId = {{newCategory.response.body.data.id}}
@vendorId = {{newVendor.response.body.data.id}}
@permitId = {{newPermit.response.body.data.id}}
# Toma el id del puesto creado en "Crear puesto" (sección de la fase 3, más abajo)
@locationId = {{newLocation.response.body.data.id}}

### ---------- GIROS (/categories) ----------

### Crear giro -> 201
# @name newCategory
POST {{baseUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nombre": "Comida", "color": "#e8201a", "icono": "🌮" }

### Nombre repetido (sin importar mayúsculas) -> 400
POST {{baseUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nombre": "comida", "color": "#e8201a", "icono": "🌮" }

### Datos inválidos -> 400 con details
POST {{baseUrl}}/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nombre": "", "color": "rojo" }

### Listar -> 200
GET {{baseUrl}}/categories
Authorization: Bearer {{token}}

### Detalle -> 200
GET {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{token}}

### Id mal formado -> 400
GET {{baseUrl}}/categories/123
Authorization: Bearer {{token}}

### Id válido que no existe -> 404
GET {{baseUrl}}/categories/6b0912824310000000000000
Authorization: Bearer {{token}}

### Editar -> 200
PATCH {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "color": "#2b45c9" }

### Editar sin campos -> 400
PATCH {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### Borrar -> 200 (o 400 si algún puesto lo usa)
DELETE {{baseUrl}}/categories/{{categoryId}}
Authorization: Bearer {{token}}

### Sin token -> 401
GET {{baseUrl}}/categories

### ---------- COMERCIANTES (/vendors) ----------

### Crear comerciante -> 201
# @name newVendor
POST {{baseUrl}}/vendors
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nombre": "José Pérez", "apodo": "Don Pepe", "telefono": "4771234567" }

### Teléfono inválido -> 400
POST {{baseUrl}}/vendors
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nombre": "Rosa", "telefono": "477-123" }

### Listar -> 200
GET {{baseUrl}}/vendors
Authorization: Bearer {{token}}

### Editar -> 200
PATCH {{baseUrl}}/vendors/{{vendorId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "apodo": "Pepe" }

### Borrar -> 200 (o 400 si atiende algún puesto)
DELETE {{baseUrl}}/vendors/{{vendorId}}
Authorization: Bearer {{token}}

### ---------- PERMISOS (/permits) ----------

### Crear permiso -> 201 (necesita un puesto existente)
# @name newPermit
POST {{baseUrl}}/permits
Authorization: Bearer {{token}}
Content-Type: application/json

{ "location": "{{locationId}}", "folio": "TL-001", "vigenteHasta": "2027-06-30", "cuota": 350 }

### Puesto que no existe -> 400
POST {{baseUrl}}/permits
Authorization: Bearer {{token}}
Content-Type: application/json

{ "location": "6b0912824310000000000000", "folio": "TL-002", "vigenteHasta": "2027-06-30", "cuota": 350 }

### Fecha imposible y cuota negativa -> 400
POST {{baseUrl}}/permits
Authorization: Bearer {{token}}
Content-Type: application/json

{ "location": "{{locationId}}", "folio": "TL-003", "vigenteHasta": "2027-02-31", "cuota": -5 }

### Listar (trae el nombre del puesto con populate) -> 200
GET {{baseUrl}}/permits
Authorization: Bearer {{token}}

### Editar -> 200
PATCH {{baseUrl}}/permits/{{permitId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "cuota": 400 }

### Borrar -> 200
DELETE {{baseUrl}}/permits/{{permitId}}
Authorization: Bearer {{token}}

# =====================================================================
# FASE 3: ZONAS Y PUESTOS (crea antes un giro y un comerciante)
# =====================================================================
@zoneId = {{newZone.response.body.data.id}}

### ---------- ZONAS (/zones) ----------

### Crear zona -> 201 (el anillo no viene cerrado: el servidor lo cierra)
# @name newZone
POST {{baseUrl}}/zones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Tianguis Centro",
  "dias": ["miercoles", "domingo"],
  "area": {
    "type": "Polygon",
    "coordinates": [[[-101.70, 21.10], [-101.66, 21.10], [-101.66, 21.14], [-101.70, 21.14]]]
  }
}

### Polígono que se cruza a sí mismo (moño) -> 400
POST {{baseUrl}}/zones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Moño",
  "area": { "type": "Polygon", "coordinates": [[[0, 0], [2, 2], [2, 0], [0, 2], [0, 0]]] }
}

### Día inválido y menos de 3 vértices -> 400
POST {{baseUrl}}/zones
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Mala",
  "dias": ["feriado"],
  "area": { "type": "Polygon", "coordinates": [[[0, 0], [1, 1]]] }
}

### Listar zonas -> 200
GET {{baseUrl}}/zones
Authorization: Bearer {{token}}

### Borrar zona -> 200
DELETE {{baseUrl}}/zones/{{zoneId}}
Authorization: Bearer {{token}}

### ---------- PUESTOS (/locations) ----------

### Crear puesto dentro de la zona -> 201 (trae giro y comerciante por nombre y el estado)
# @name newLocation
POST {{baseUrl}}/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Tacos Don Pepe",
  "descripcion": "Tacos al pastor y de suadero",
  "category": "{{categoryId}}",
  "vendor": "{{vendorId}}",
  "ubicacion": { "type": "Point", "coordinates": [-101.68, 21.12] }
}

### Coordenadas invertidas [lat, lng] -> 400
POST {{baseUrl}}/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nombre": "Mal ubicado",
  "descripcion": "Prueba",
  "category": "{{categoryId}}",
  "ubicacion": { "type": "Point", "coordinates": [21.12, -101.68] }
}

### Listar todos (cada uno con su estado) -> 200
GET {{baseUrl}}/locations
Authorization: Bearer {{token}}

### Búsqueda parcial sin mayúsculas -> 200
GET {{baseUrl}}/locations?search=TACO
Authorization: Bearer {{token}}

### Filtrar por giro -> 200
GET {{baseUrl}}/locations?category={{categoryId}}
Authorization: Bearer {{token}}

### Filtrar por zona ($geoWithin) -> 200
GET {{baseUrl}}/locations?zone={{zoneId}}
Authorization: Bearer {{token}}

### Los tres filtros juntos -> 200
GET {{baseUrl}}/locations?search=tacos&category={{categoryId}}&zone={{zoneId}}
Authorization: Bearer {{token}}

### Zona mal formada -> 400
GET {{baseUrl}}/locations?zone=abc
Authorization: Bearer {{token}}

### Detalle -> 200
GET {{baseUrl}}/locations/{{locationId}}
Authorization: Bearer {{token}}

### Editar (lo que hará el popup) -> 200
PATCH {{baseUrl}}/locations/{{locationId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{ "nombre": "Tacos El Pepe", "vendor": null }

### Borrar puesto (también borra sus permisos) -> 200
DELETE {{baseUrl}}/locations/{{locationId}}
Authorization: Bearer {{token}}
